# --- Modbus TCP listener ---
MODBUS_HOST=0.0.0.0
MODBUS_PORT=502
MODBUS_UNIT_ID=1

# --- HTTP admin UI ---
ADMIN_HOST=0.0.0.0
ADMIN_PORT=5050

# --- Identita' device emulato ---
HUAWEI_MODEL=SUN2000-10KTL-M1
HUAWEI_SN=INV12345678901234
HUAWEI_PN=02311GFG
HUAWEI_FW=V100R001C00SPC120
HUAWEI_RATED_POWER_W=10000
HUAWEI_MAX_ACTIVE_POWER_W=10000
HUAWEI_MAX_APPARENT_POWER_VA=11000
HUAWEI_PV_STRINGS=2
HUAWEI_MPPT_COUNT=2
HUAWEI_HAS_BATTERY=true

# --- OpenHAB REST ---
OPENHAB_BASE_URL=http://192.168.0.200:8080
OPENHAB_REQUEST_TIMEOUT_S=5

# --- Poll cadence ---
# Aggiorna i registri Modbus ogni N secondi rileggendo gli items OH.
# Tipico: 5 s (cattura cambi rapidi senza martellare OH).
POLL_INTERVAL_S=5

# --- MOCK MODE per debug ---
# Quando true, bypassa OpenHAB e usa valori fissi (vedi app/openhab.py:MOCK_ITEMS).
# Utile per capire dove l'app client mappa ciascun registro.
MOCK_MODE=false

# --- Logging ---
LOG_LEVEL=INFO
